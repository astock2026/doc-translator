# DocTranslator — Environment Variables
# Copy this to .env for local development, or set these on Render.com

# Flask secret key (generate a random string)
SECRET_KEY=replace-with-a-random-secret-key

# LLM API (DeepSeek, OpenAI, or Gemini)
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# SMTP for email notifications (Hotmail/Outlook)
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=adam_j_cheng@hotmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM=adam_j_cheng@hotmail.com
NOTIFY_EMAIL=adam_j_cheng@hotmail.com

# Admin dashboard password
ADMIN_PASSWORD=choose-a-strong-password
